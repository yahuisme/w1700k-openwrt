#!/bin/sh

# Only seed fresh configurations; restored and user-defined LEDs stay untouched.
[ -f /sysupgrade.tgz ] || [ -f /tmp/sysupgrade.tar ] && exit 0

. /lib/functions.sh

has_white=0
check_white() {
    local sysfs
    config_get sysfs "$1" sysfs
    [ "$sysfs" = 'white:status' ] && has_white=1
}
config_load system
config_foreach check_white led
[ "$has_white" = 0 ] || exit 0
uci -q get system.led_wan_status >/dev/null && exit 0

case "$(uci -q get network.wan.proto)" in
    pppoe) dev='pppoe-wan' ;;
    dhcp|static) dev="$(uci -q get network.wan.device)" ;;
    *) exit 0 ;;
esac
[ -n "$dev" ] || exit 0

uci set system.led_wan_status=led
uci set system.led_wan_status.name='WAN status'
uci set system.led_wan_status.sysfs='white:status'
uci set system.led_wan_status.trigger='netdev'
uci set system.led_wan_status.dev="$dev"
uci set system.led_wan_status.mode='link'
uci set system.led_wan_status.default='0'

# /etc/init.d/boot commits all UCI defaults together.
exit 0
