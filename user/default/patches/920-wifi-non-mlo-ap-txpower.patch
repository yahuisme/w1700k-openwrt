+// Apply only to a BSS owned by the current non-MLO configuration.
+// No delayed worker: hostapd owns creation, restart and cancellation.
+function bss_txpower(phy, name)
+{
+	let config = hostapd.data.config[phy];
+	if (config?.txpower == null)
+		return;
+
+	let owned;
+	for (let bss in config.bss)
+		if (bss.ifname == name)
+			owned = bss;
+	if (!owned || owned.mld_ap)
+		return;
+
+	let cmd = [ 'iw', 'dev', name, 'set', 'txpower' ];
+	for (let arg in split(config.txpower, ' '))
+		push(cmd, arg);
+	let status = system(cmd);
+	if (status) {
+		hostapd.printf(`Failed to set txpower on ${phy}/${name}: ${config.txpower} (status ${status})`);
+		bss_event("txpower_failed", name, { phy, status });
+	}
+}
