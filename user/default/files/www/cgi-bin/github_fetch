#!/bin/sh

# CGI header
echo "Content-Type: application/json"
echo ""

QUERY_STRING="${QUERY_STRING:-$1}"
case "$QUERY_STRING" in
    tag=*) TAG="${QUERY_STRING#tag=}" ;;
    *) TAG="$QUERY_STRING" ;;
esac
TAG="$(printf '%s' "$TAG" | sed 's/%2B/+/g; s/%3D/=/g; s/%2F/\//g; s/%25/%/g')"

case "$TAG" in
    ''|*[!A-Za-z0-9._+/-]*)
        echo '{"error":"Invalid release tag"}'
        exit 0
        ;;
esac

API_URL="https://api.github.com/repos/yahuisme/w1700k-openwrt/releases/tags/$TAG"
RELEASE_JSON="/tmp/github_release_$$.json"
DOWNLOAD_FILE="$(mktemp /tmp/w1700k-firmware.XXXXXX)"
DOWNLOAD_SHA="$(mktemp /tmp/w1700k-sha256.XXXXXX)"

cleanup() {
    rm -f "$RELEASE_JSON" "$DOWNLOAD_FILE" "$DOWNLOAD_SHA"
}
trap cleanup EXIT INT TERM

if ! curl --fail --silent --show-error --connect-timeout 10 --max-time 30 \
    "$API_URL" -o "$RELEASE_JSON"; then
    echo '{"error":"Failed to fetch release metadata"}'
    exit 0
fi

ASSET_JSON="$(jq -c '[.assets[] | select(.name == "openwrt-airoha-an7581-gemtek_w1700k-ubi-squashfs-sysupgrade.itb")]' "$RELEASE_JSON")"
ASSET_COUNT="$(printf '%s' "$ASSET_JSON" | jq 'length')"

if [ "$ASSET_COUNT" -ne 1 ]; then
    echo '{"error":"Expected exactly one W1700K sysupgrade firmware asset"}'
    exit 0
fi

URL="$(printf '%s' "$ASSET_JSON" | jq -r '.[0].browser_download_url')"
ASSET_DIGEST="$(printf '%s' "$ASSET_JSON" | jq -r '.[0].digest // empty' | sed 's/^sha256://')"
FILENAME="$(printf '%s' "$ASSET_JSON" | jq -r '.[0].name')"

if ! printf '%s' "$URL" | grep -Eq '^https://github\.com/yahuisme/w1700k-openwrt/releases/download/[^/]+/openwrt-airoha-an7581-gemtek_w1700k-ubi-squashfs-sysupgrade\.itb$'; then
    echo '{"error":"Unexpected firmware download URL"}'
    exit 0
fi

EXPECTED_SHA256="$ASSET_DIGEST"
if ! printf '%s' "$EXPECTED_SHA256" | grep -Eq '^[A-Fa-f0-9]{64}$'; then
    SHA256_URL="$(jq -r '[.assets[] | select(.name == "sha256sums")][0].browser_download_url // empty' "$RELEASE_JSON")"
    if [ -z "$SHA256_URL" ] || ! curl --fail --silent --show-error --connect-timeout 10 --max-time 30 \
        "$SHA256_URL" -o "$DOWNLOAD_SHA"; then
        echo '{"error":"No valid SHA256 digest found for firmware"}'
        exit 0
    fi
    EXPECTED_SHA256="$(awk -v file="$FILENAME" '$2 == file || $2 == "*" file {print $1; exit}' "$DOWNLOAD_SHA")"
fi

if ! printf '%s' "$EXPECTED_SHA256" | grep -Eq '^[A-Fa-f0-9]{64}$'; then
    echo '{"error":"Invalid SHA256 digest for firmware"}'
    exit 0
fi

if ! curl --fail --silent --show-error --location --connect-timeout 10 --max-time 300 \
    "$URL" -o "$DOWNLOAD_FILE" || [ ! -s "$DOWNLOAD_FILE" ]; then
    echo '{"error":"Failed to download firmware"}'
    exit 0
fi

ACTUAL_SHA256="$(sha256sum "$DOWNLOAD_FILE" | awk '{print $1}')"
if [ "${ACTUAL_SHA256,,}" != "${EXPECTED_SHA256,,}" ]; then
    echo '{"error":"Firmware SHA256 verification failed"}'
    exit 0
fi

if ! command -v sysupgrade >/dev/null 2>&1 || ! sysupgrade -T "$DOWNLOAD_FILE" >/dev/null 2>&1; then
    echo '{"error":"Firmware compatibility check failed"}'
    exit 0
fi

mv -f "$DOWNLOAD_FILE" /tmp/firmware.bin
DOWNLOAD_FILE=""
printf '{"success":true,"path":"/tmp/firmware.bin","sha256":"%s"}\n' "$ACTUAL_SHA256"
