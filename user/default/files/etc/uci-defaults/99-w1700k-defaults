#!/bin/sh

# ============================================================
# W1700K default configuration
# ============================================================

# ------------------------------------------------------------
# Preserve all settings during config-retaining sysupgrade
# ------------------------------------------------------------
# sysupgrade restores its configuration archive before uci-default scripts
# run, and removes that archive only later in the boot sequence. Detect the
# actual retained-config upgrade instead of relying on a project-specific
# first-boot marker: this also protects users who arrived from another
# firmware and have never run this script before.

if [ -f /sysupgrade.tgz ] || [ -f /tmp/sysupgrade.tar ]; then
    echo "Keeping existing configuration restored by sysupgrade."
    exit 0
fi


# Read the complete radio inventory before changing any configuration.
# Stable section IDs avoid anonymous wifi-iface index shifts during deletion.
WIRELESS="$(uci -q -X show wireless)" || exit 1
RADIO_2G=""
RADIO_5G=""
RADIO_6G=""
for DEV in $(printf '%s\n' "$WIRELESS" | \
    sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    BAND="$(uci -q get wireless.${DEV}.band)" || exit 1
    case "$BAND" in
        2g) RADIO_2G="$DEV" ;;
        5g) RADIO_5G="$DEV" ;;
        6g) RADIO_6G="$DEV" ;;
        *) exit 1 ;;
    esac
done
[ -n "$RADIO_2G" ] && [ -n "$RADIO_5G" ] && [ -n "$RADIO_6G" ] || exit 1

# Boot commits even when a defaults script fails. Keep our deltas private until
# every required operation succeeds; -P still reads earlier defaults' deltas.
WORK="$(mktemp -d /tmp/w1700k-defaults.XXXXXX)" || exit 1
NEXT="$WORK/next"
cleanup() {
    STATUS=$?
    trap '' HUP INT TERM
    trap - EXIT
    # The second rename is the commit point, even if mv reports failure or a
    # signal arrives before the shell observes its result. Boot will commit the
    # published deltas, so report success and let it remove this defaults script.
    if [ -d "$WORK/previous" ] && [ ! -e "$NEXT" ] && [ -d /tmp/.uci ]; then
        STATUS=0
    elif [ -d "$WORK/previous" ]; then
        if [ -e /tmp/.uci ] || ! mv "$WORK/previous" /tmp/.uci; then
            echo "W1700K defaults: restore failed; previous deltas kept at $WORK/previous" >&2
            exit "$STATUS"
        fi
    fi
    rm -rf "$WORK"
    exit "$STATUS"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
STAGE="$WORK/delta"
mkdir "$STAGE" || exit 1
wuci() { uci -P "$STAGE" "$@" || exit 1; }

# ------------------------------------------------------------
# System timezone
# ------------------------------------------------------------

wuci -q set system.@system[0].zonename='Asia/Hong_Kong'
wuci -q set system.@system[0].timezone='HKT-8'
wuci -q set system.@system[0].hostname='W1700K'


# ------------------------------------------------------------
# Default LAN network
# ------------------------------------------------------------

# Default management address: 192.168.8.1/24.
# Replace the address option first so deleting it has no "not found" exception.
wuci -q set network.lan.ipaddr='192.168.8.1/24'
wuci -q delete network.lan.ipaddr
wuci -q add_list network.lan.ipaddr='192.168.8.1/24'

# IPv6: RA server mode, DHCPv6 disabled.
wuci -q set dhcp.lan.dhcpv6='disabled'
wuci -q set dhcp.lan.ra='server'


# ------------------------------------------------------------
# LuCI language / theme
# ------------------------------------------------------------

wuci -q set luci.main.lang='zh-cn'
wuci -q set luci.main.mediaurlbase='/luci-static/aurora'

# Enable software and hardware flow offloading by default for the PPPoE router.
wuci -q set firewall.@defaults[0].flow_offloading='1'
wuci -q set firewall.@defaults[0].flow_offloading_hw='1'


# ------------------------------------------------------------
# Find Wi-Fi radios and create first-boot defaults
# ------------------------------------------------------------


# ------------------------------------------------------------
# 2.4 GHz
# ------------------------------------------------------------

wuci -q set wireless.${RADIO_2G}.disabled='0'
wuci -q set wireless.${RADIO_2G}.country='US'
wuci -q set wireless.${RADIO_2G}.channel='1'
wuci -q set wireless.${RADIO_2G}.htmode='EHT20'
wuci -q set wireless.${RADIO_2G}.txpower='23'


# ------------------------------------------------------------
# 5 GHz
# ------------------------------------------------------------

wuci -q set wireless.${RADIO_5G}.disabled='0'
wuci -q set wireless.${RADIO_5G}.country='US'
wuci -q set wireless.${RADIO_5G}.channel='36'
wuci -q set wireless.${RADIO_5G}.htmode='EHT160'
wuci -q set wireless.${RADIO_5G}.txpower='25'


# ------------------------------------------------------------
# 6 GHz
# ------------------------------------------------------------

# 6 GHz is configured but disabled by default.
# Enable it manually from LuCI when needed.
wuci -q set wireless.${RADIO_6G}.disabled='1'
wuci -q set wireless.${RADIO_6G}.country='US'
wuci -q set wireless.${RADIO_6G}.channel='37'
wuci -q set wireless.${RADIO_6G}.htmode='EHT320'
wuci -q set wireless.${RADIO_6G}.txpower='25'


# ------------------------------------------------------------
# Remove existing Wi-Fi interface defaults
# ------------------------------------------------------------

for IFACE in $(printf '%s\n' "$WIRELESS" | \
    sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p')
do
    wuci -q delete wireless.${IFACE}
done


# ------------------------------------------------------------
# 2.4 GHz SSID
# ------------------------------------------------------------

IFACE_2G="wifinet2g"
wuci set wireless.${IFACE_2G}=wifi-iface

wuci set wireless.${IFACE_2G}.device="${RADIO_2G}"
wuci set wireless.${IFACE_2G}.mode='ap'
wuci set wireless.${IFACE_2G}.network='lan'
wuci set wireless.${IFACE_2G}.ssid='W1700K'
wuci set wireless.${IFACE_2G}.encryption='psk2+ccmp'
wuci set wireless.${IFACE_2G}.key='12345678'


# ------------------------------------------------------------
# 5 GHz SSID
# ------------------------------------------------------------

IFACE_5G="wifinet5g"
wuci set wireless.${IFACE_5G}=wifi-iface

wuci set wireless.${IFACE_5G}.device="${RADIO_5G}"
wuci set wireless.${IFACE_5G}.mode='ap'
wuci set wireless.${IFACE_5G}.network='lan'
wuci set wireless.${IFACE_5G}.ssid='W1700K'
wuci set wireless.${IFACE_5G}.encryption='psk2+ccmp'
wuci set wireless.${IFACE_5G}.key='12345678'


# ------------------------------------------------------------
# 6 GHz SSID
# ------------------------------------------------------------

IFACE_6G="wifinet6g"
wuci set wireless.${IFACE_6G}=wifi-iface

wuci set wireless.${IFACE_6G}.device="${RADIO_6G}"
wuci set wireless.${IFACE_6G}.mode='ap'
wuci set wireless.${IFACE_6G}.network='lan'
wuci set wireless.${IFACE_6G}.ssid='W1700K-6G'
wuci set wireless.${IFACE_6G}.encryption='sae+ccmp'
wuci set wireless.${IFACE_6G}.key='12345678'


# Prepare a complete replacement of boot's delta directory, including earlier
# defaults. Publish it with renames only after all fallible writes/copies pass.
# Boot runs these scripts sequentially; no long-lived service is needed.
cp -a /tmp/.uci "$NEXT" || exit 1
for FILE in "$STAGE"/*; do
    [ -f "$FILE" ] || continue
    cat "$FILE" >> "$NEXT/${FILE##*/}" || exit 1
done
mv /tmp/.uci "$WORK/previous" || exit 1
mv "$NEXT" /tmp/.uci || exit 1
# /etc/init.d/boot commits all UCI defaults together.
exit 0
