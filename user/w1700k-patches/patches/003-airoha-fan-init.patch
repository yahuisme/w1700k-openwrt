Subject: [PATCH] airoha: identify the fan controller before initialization

Backport Andrey Korshunov's OpenWrt PR #26929
(0e4160756e99a1c2cc1e91d67e6574007b1b04f6).
Keep each distribution's board list and require the control attribute.
https://github.com/openwrt/openwrt/pull/26929

--- a/target/linux/airoha/an7581/base-files/etc/init.d/airoha_fan
+++ b/target/linux/airoha/an7581/base-files/etc/init.d/airoha_fan
@@ -12,8 +12,9 @@
 	for hwmon in /sys/class/hwmon/hwmon*; do
-		if [ -f "$hwmon/name" ] && [ "$(cat "$hwmon/name" 2>/dev/null)" = "nct7802" ]; then
+		if [ -f "$hwmon/name" ] && [ -f "$hwmon/pwm1_enable" ] &&
+		   [ "$(cat "$hwmon/name" 2>/dev/null)" = "nct7802" ]; then
 			echo "$hwmon"
-			return
+			return 0
 		fi
 	done
-	echo "/sys/class/hwmon/hwmon5" # fallback
+	return 1
 }
@@ -22,2 +23,4 @@
 {
+	local hwmon
+
 	case $(board_name) in
@@ -26,21 +29,37 @@
 		hwmon=$(find_nct7802)
+		[ -n "$hwmon" ] || {
+			logger -t airoha_fan "NCT7802 not found, fan curve unchanged"
+			return 0
+		}
 
-		# Temporarily disable automatic fan control to configure curve
-		echo 1 > $hwmon/pwm1_enable
+		if ! {
+			# Temporarily disable automatic fan control to configure curve
+			echo 1 > "$hwmon/pwm1_enable" &&
 
-		# Match trigger points from vendor firmware
-		echo 40000 > $hwmon/pwm1_auto_point1_temp
-		echo 50000 > $hwmon/pwm1_auto_point2_temp
-		echo 60000 > $hwmon/pwm1_auto_point3_temp
-		echo 70000 > $hwmon/pwm1_auto_point4_temp
-		echo 80000 > $hwmon/pwm1_auto_point5_temp
+			# Match trigger points from vendor firmware
+			echo 40000 > "$hwmon/pwm1_auto_point1_temp" &&
+			echo 50000 > "$hwmon/pwm1_auto_point2_temp" &&
+			echo 60000 > "$hwmon/pwm1_auto_point3_temp" &&
+			echo 70000 > "$hwmon/pwm1_auto_point4_temp" &&
+			echo 80000 > "$hwmon/pwm1_auto_point5_temp" &&
 
-		# Match fan speed from vendor firmware
-		echo 54  > $hwmon/pwm1_auto_point1_pwm
-		echo 69  > $hwmon/pwm1_auto_point2_pwm
-		echo 95  > $hwmon/pwm1_auto_point3_pwm
-		echo 199 > $hwmon/pwm1_auto_point4_pwm
+			# Match fan speed from vendor firmware
+			echo 54  > "$hwmon/pwm1_auto_point1_pwm" &&
+			echo 69  > "$hwmon/pwm1_auto_point2_pwm" &&
+			echo 95  > "$hwmon/pwm1_auto_point3_pwm" &&
+			echo 199 > "$hwmon/pwm1_auto_point4_pwm"
+		}; then
+			logger -t airoha_fan "failed to set the fan curve, restoring automatic control"
+			if echo 2 > "$hwmon/pwm1_enable"; then
+				return 0
+			fi
+			logger -t airoha_fan "failed to restore automatic control, fan left in manual mode"
+			return 1
+		fi
 
 		# Re-enable automatic fan control
-		echo 2 > $hwmon/pwm1_enable
+		echo 2 > "$hwmon/pwm1_enable" || {
+			logger -t airoha_fan "failed to restore automatic control, fan left in manual mode"
+			return 1
+		}
 		;;
