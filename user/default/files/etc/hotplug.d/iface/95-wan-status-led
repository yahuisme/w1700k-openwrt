#!/bin/sh
# Logical WAN state only; no reachability probes or background process.
(
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = gemtek,w1700k-ubi ] || exit 0
[ "$(uci -q get system.@system[0].wan_led)" != 0 ] || exit 0
[ "$(uci -q get system.@system[-1].leds_off)" != 1 ] || exit 0
wan="$(uci -q get system.@system[0].wan_led_interface)"
wan="${wan:-wan}"
case "$ACTION" in
    boot) ;;
    ifup|ifdown|ifupdate) [ "$INTERFACE" = "$wan" ] || exit 0 ;;
    *) exit 0 ;;
esac
[ -e /var/run/wan-status-led-ready ] || exit 0
[ ! -e /tmp/wan-status-led-upgrade ] || exit 0
status="$(ubus -t 2 call "network.interface.$wan" status 2>/dev/null)" || exit 0
up="$(printf '%s' "$status" | jsonfilter -e '@.up' 2>/dev/null)"
case "$up" in true|false) ;; *) exit 0 ;; esac
# Respect user triggers and native diagnostic ownership after the query.
leds=/sys/class/leds
for color in white red green blue; do
    [ -d "$leds/$color:status" ] || exit 0
    case "$(cat "$leds/$color:status/trigger")" in
        *\[none\]*) ;;
        *) exit 0 ;;
    esac
done
[ ! -e /tmp/wan-status-led-upgrade ] || exit 0
for color in white red; do
    value=0
    case "$up:$color" in
        true:white|false:red) value="$(cat "$leds/$color:status/max_brightness")" ;;
    esac
    [ ! -e /tmp/wan-status-led-upgrade ] || break
    printf '%s\n' "$value" > "$leds/$color:status/brightness"
done
# An upgrade racing the final writes owns the lamp; blue is native-owned.
if [ -e /tmp/wan-status-led-upgrade ]; then
    echo 0 > "$leds/white:status/brightness"
    echo 0 > "$leds/red:status/brightness"
fi
)
